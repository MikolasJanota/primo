diff --git a/tests/unit/arithmetic_phase_simulation_tests.cpp b/tests/unit/arithmetic_phase_simulation_tests.cpp
new file mode 100644
index 00000000..dd446417
--- /dev/null
+++ b/tests/unit/arithmetic_phase_simulation_tests.cpp
@@ -0,0 +1,129 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+#include <cassert>
+#include <optional>
+#include <stdexcept>
+
+#include "smt/arithmetic_phase_simulation.hpp"
+#include "theory/arithmetic/lia_integer_values.hpp"
+#include "util/rational.hpp"
+
+using Probe = primo::smt::ArithmeticPhaseSimulation;
+using primo::util::Rational;
+
+namespace {
+Probe::Domain range(int lower, int upper) { return {Rational(lower), Rational(upper)}; }
+
+void revisit(Probe& probe) {
+  probe.domain(0, range(0, 17));
+  probe.domain(0, range(16, 17));
+  probe.domain(0, range(0, 17));
+  probe.domain(0, range(16, 17));
+  probe.domain(0, range(0, 17));
+}
+
+int choose(Probe& probe, int beta = 7, bool unassigned = true, bool integer = true,
+           int true_literal = 7) {
+  return probe.choose(0, 0, true_literal, beta, unassigned, integer, false, Rational(16),
+                      Rational(15));
+}
+
+void geometric_policies() {
+  Probe least({.mode = Probe::Mode::Least});
+  least.domain(0, range(0, 17));
+  assert(choose(least) == -7);  // immediate geometry control, without a revisit gate
+  revisit(least);
+  assert(choose(least) == -7);
+  assert(least.counts().repeated == 1);
+  assert(least.counts().flips == 2);
+  assert(choose(least) == -7);
+  assert(least.counts().flips == 2);
+  assert(choose(least, 7, false) == 7);
+  assert(choose(least, 7, true, false) == 7);
+
+  Probe most({.mode = Probe::Mode::Most});
+  most.domain(0, range(0, 17));
+  assert(choose(most, -7) == 7);
+  revisit(most);
+  assert(choose(most, -7) == 7);
+
+  Probe negative({.mode = Probe::Mode::Least});
+  revisit(negative);
+  assert(choose(negative, -7, true, true, -7) == 7);
+
+  Probe upper({.mode = Probe::Mode::Most});
+  upper.domain(0, range(0, 17));
+  upper.domain(0, range(0, 1));
+  upper.domain(0, range(0, 17));
+  upper.domain(0, range(0, 1));
+  upper.domain(0, range(0, 17));
+  assert(upper.choose(0, 0, 9, -9, true, true, true, Rational(1), Rational(2)) == 9);
+}
+
+void bounds_and_history() {
+  Probe probe({.mode = Probe::Mode::Least, .history_limit = 2});
+  probe.domain(0, {});
+  assert(choose(probe) == 7);
+  assert(probe.counts().finite_splits == 0);
+  probe.domain(0, range(0, 17));
+  const auto entries = probe.counts().entries;
+  probe.domain(0, range(0, 17));
+  assert(probe.counts().entries == entries);
+  probe.domain(0, range(16, 17));
+  probe.domain(0, range(2, 14));
+  assert(probe.history_size() == 2);
+  assert(probe.counts().evictions == 1);
+  probe.domain(0, range(16, 17));
+  assert(choose(probe) == 7);  // the false side has no remaining integer candidate
+
+  using primo::theory::arithmetic::delta_ceil;
+  using primo::theory::arithmetic::delta_floor;
+  using primo::theory::arithmetic::DeltaRational;
+  const DeltaRational lower{Rational(-3), Rational(1)};
+  const DeltaRational upper{Rational(2), Rational(-1)};
+  const Probe::Domain strict{delta_ceil(lower), delta_floor(upper)};
+  assert(strict == range(-2, 1));
+}
+
+void seeded_sampling_and_gating() {
+  Probe left({.mode = Probe::Mode::Random, .seed = 20261105, .denominator = 4});
+  Probe right({.mode = Probe::Mode::Random, .seed = 20261105, .denominator = 4});
+  for (int index = 0; index < 100; ++index) {
+    left.domain(0, range(0, index + 2));
+    right.domain(0, range(0, index + 2));
+    assert(choose(left) == choose(right));
+    const auto flips = left.counts().flips;
+    static_cast<void>(choose(left));
+    assert(left.counts().flips == flips);
+  }
+  assert(left.counts().flips > 0 && left.counts().flips < 100);
+
+  Probe gated({.mode = Probe::Mode::Gated, .denominator = 1});
+  gated.domain(0, range(0, 17));
+  assert(choose(gated) == 7);
+  revisit(gated);
+  assert(choose(gated) == -7);
+  assert(choose(gated, -7) == -7);  // beta already selects the wider side
+
+  Probe always({.mode = Probe::Mode::Random, .denominator = 1});
+  always.domain(0, {});
+  assert(choose(always) == -7);
+  assert(choose(always, 7, false) == 7);
+
+  bool rejected = false;
+  try {
+    const Probe invalid({.denominator = 0});
+  } catch (const std::invalid_argument&) {
+    rejected = true;
+  }
+  assert(rejected);
+}
+}  // namespace
+
+int main() {
+  geometric_policies();
+  bounds_and_history();
+  seeded_sampling_and_gating();
+}
diff --git a/tests/unit/phase_probe_tests.cpp b/tests/unit/phase_probe_tests.cpp
new file mode 100644
index 00000000..6fa723c5
--- /dev/null
+++ b/tests/unit/phase_probe_tests.cpp
@@ -0,0 +1,91 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+#include <cassert>
+
+#include "sat/phase_probe.hpp"
+
+using primo::sat::PhaseProbe;
+
+namespace {
+void cancel(PhaseProbe& probe, int literal) {
+  probe.new_level();
+  probe.assignment(literal, true);
+  probe.backtrack(0);
+}
+
+void count_only_context_matching_decisions() {
+  PhaseProbe probe({.mode = PhaseProbe::Mode::Release, .threshold = 2, .window = 2});
+  probe.hint(1);
+  probe.new_level();
+  probe.assignment(1, false);
+  assert(probe.backtrack(0).empty());
+  assert(probe.counts().aligned_removed == 0);
+  probe.assume(1);
+  cancel(probe, 1);
+  assert(probe.counts().assumptions == 1 && probe.counts().activations == 0);
+  probe.finish_solve();
+  cancel(probe, -1);
+  assert(probe.counts().aligned_removed == 0);
+  probe.new_level();
+  probe.assignment(1, true);
+  probe.hint(-1);
+  probe.hint(1);
+  assert(probe.backtrack(0).empty());
+  assert(probe.counts().aligned_removed == 0);
+  cancel(probe, 1);
+  assert(probe.counts().activations == 0);
+  probe.new_level();
+  probe.assignment(1, true);
+  const auto release = probe.backtrack(0);
+  assert(release.size() == 1 && release[0].release && release[0].literal == 1);
+  assert(probe.counts().activations == 1);
+  probe.new_level();
+  assert(probe.assignment(1, true).empty());
+  assert(probe.backtrack(0).empty());  // An overridden decision does not retrigger.
+  probe.new_level();
+  const auto restored = probe.assignment(2, true);
+  assert(restored.size() == 1 && !restored[0].release && restored[0].literal == 1);
+  assert(probe.counts().restores == 1);
+}
+
+void opposite_sign_and_changed_hint() {
+  PhaseProbe probe({.mode = PhaseProbe::Mode::Invert, .threshold = 1});
+  probe.hint(-2);
+  probe.new_level();
+  probe.assignment(-2, true);
+  const auto opposite = probe.backtrack(0);
+  assert(opposite.size() == 1 && opposite[0].literal == 2 && !opposite[0].release);
+  const auto changed = probe.hint(2);
+  assert(changed.literal == 2 && !changed.release);
+  probe.new_level();
+  probe.assignment(-2, true);
+  assert(probe.backtrack(0).empty());
+}
+
+void static_controls_and_solve_reset() {
+  PhaseProbe probe({.mode = PhaseProbe::Mode::Release, .threshold = 0});
+  assert(probe.hint(3).release);
+  assert(probe.finish_solve().size() == 1);
+  const auto next = probe.begin_solve();
+  assert(next.size() == 1 && next[0].release);
+  PhaseProbe counted({.mode = PhaseProbe::Mode::Release, .threshold = 2});
+  counted.hint(3);
+  cancel(counted, 3);
+  counted.finish_solve();
+  cancel(counted, 3);
+  assert(counted.counts().activations == 0);
+  PhaseProbe observe({.mode = PhaseProbe::Mode::Observe, .threshold = 1});
+  assert(!observe.hint(1).release);
+  cancel(observe, 1);
+  cancel(observe, 1);
+  assert(observe.counts().activations == 0 && observe.counts().aligned_removed == 2);
+}
+}  // namespace
+
+int main() {
+  count_only_context_matching_decisions();
+  opposite_sign_and_changed_hint();
+  static_controls_and_solve_reset();
+}
