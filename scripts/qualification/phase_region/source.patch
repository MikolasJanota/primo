diff --git a/src/sat/phase_probe.hpp b/src/sat/phase_probe.hpp
new file mode 100644
index 00000000..6ed3e749
--- /dev/null
+++ b/src/sat/phase_probe.hpp
@@ -0,0 +1,243 @@
+#pragma once
+
+#include <charconv>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <optional>
+#include <stdexcept>
+#include <string_view>
+#include <system_error>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace primo::sat {
+
+// Isolated diagnostic, original design: docs/leads/adaptive-phase-probe.md.
+// Phase advice is never a proof reason. The controller returns actions so no
+// reference into its storage survives an operation on the borrowed backend.
+class PhaseProbe {
+ public:
+  enum class Mode { Observe, Release, Invert };
+  struct Config {
+    Mode mode = Mode::Observe;
+    std::size_t threshold = 8;
+    std::size_t window = 64;
+    std::size_t trace_limit = 0;
+    bool report = false;
+  };
+  struct Action {
+    int literal;
+    bool release;
+  };
+  struct Counts {
+    std::size_t hints = 0, changes = 0, decisions = 0, hinted = 0, aligned = 0;
+    std::size_t overridden = 0, propagated = 0, assumptions = 0, removed = 0;
+    std::size_t aligned_removed = 0, activations = 0, releases = 0, inversions = 0;
+    std::size_t restores = 0;
+  };
+
+  explicit PhaseProbe(Config config) : config_(config) {
+    if (config.window == 0) throw std::invalid_argument("phase probe window must be positive");
+  }
+  ~PhaseProbe() {
+    if (!config_.report) return;
+    std::fprintf(stderr,
+                 "PHASE_PROBE_SUMMARY {\"hints\":%zu,\"changes\":%zu,\"decisions\":%zu,"
+                 "\"hinted\":%zu,\"aligned\":%zu,\"overridden\":%zu,\"propagated\":%zu,"
+                 "\"assumptions\":%zu,\"removed\":%zu,\"aligned_removed\":%zu,"
+                 "\"activations\":%zu,\"releases\":%zu,\"inversions\":%zu,\"restores\":%zu}\n",
+                 counts_.hints, counts_.changes, counts_.decisions, counts_.hinted, counts_.aligned,
+                 counts_.overridden, counts_.propagated, counts_.assumptions, counts_.removed,
+                 counts_.aligned_removed, counts_.activations, counts_.releases, counts_.inversions,
+                 counts_.restores);
+  }
+  PhaseProbe(const PhaseProbe&) = delete;
+  PhaseProbe& operator=(const PhaseProbe&) = delete;
+
+  static std::optional<Config> environment() {
+    const char* text = std::getenv("PRIMO_PHASE_PROBE");
+    if (text == nullptr) return std::nullopt;
+    Config config;
+    const std::string_view mode(text);
+    if (mode == "release")
+      config.mode = Mode::Release;
+    else if (mode == "invert")
+      config.mode = Mode::Invert;
+    else if (mode != "observe")
+      throw std::invalid_argument("invalid PRIMO_PHASE_PROBE");
+    config.threshold = number("PRIMO_PHASE_PROBE_K", 8);
+    config.window = number("PRIMO_PHASE_PROBE_WINDOW", 64);
+    config.trace_limit = number("PRIMO_PHASE_PROBE_TRACE", 0);
+    config.report = true;
+    return config;
+  }
+
+  const Counts& counts() const { return counts_; }
+  void assume(int literal) { assumptions_.insert(variable(literal)); }
+  void connect() {
+    live_.clear();
+    level_ = 0;
+  }
+  void new_level() { ++level_; }
+
+  Action hint(int literal) {
+    ++counts_.hints;
+    auto& state = hints_[variable(literal)];
+    if (state.literal != literal) {
+      ++counts_.changes;
+      const auto context = state.context + 1;
+      state = Hint{literal, 0, 0, context, false};
+      active_.erase(variable(literal));
+    }
+    if (config_.mode != Mode::Observe && config_.threshold == 0 && !state.active) {
+      activate(variable(literal), state);
+    }
+    return action(state);
+  }
+
+  std::vector<Action> assignment(int literal, bool decision) {
+    std::vector<Action> result;
+    if (!decision) {
+      ++counts_.propagated;
+      return result;
+    }
+    if (assumptions_.contains(variable(literal))) {
+      ++counts_.assumptions;
+      return result;
+    }
+    if (level_ == 0) return result;  // Re-observation is not a fresh decision.
+    ++clock_;
+    ++counts_.decisions;
+    const auto found = hints_.find(variable(literal));
+    if (found != hints_.end()) {
+      const Hint snapshot = found->second;
+      ++counts_.hinted;
+      if (snapshot.active) ++counts_.overridden;
+      if (literal == snapshot.literal) ++counts_.aligned;
+      live_.push_back(
+          Decision{literal, snapshot.literal, level_, snapshot.context, snapshot.active});
+      trace("decision", literal, snapshot.literal);
+    }
+    for (auto it = active_.begin(); it != active_.end();) {
+      auto& state = hints_.at(*it);
+      if (config_.threshold != 0 && clock_ >= state.until) {
+        state.active = false;
+        state.removals = 0;
+        result.push_back(Action{state.literal, false});
+        ++counts_.restores;
+        it = active_.erase(it);
+      } else
+        ++it;
+    }
+    return result;
+  }
+
+  std::vector<Action> backtrack(std::size_t level) {
+    std::vector<Action> result;
+    while (!live_.empty() && live_.back().level > level) {
+      const Decision decision = live_.back();
+      live_.pop_back();
+      ++counts_.removed;
+      auto& state = hints_.at(variable(decision.literal));
+      if (!decision.overridden && !state.active && decision.literal == decision.hint &&
+          state.literal == decision.hint && state.context == decision.context) {
+        ++counts_.aligned_removed;
+        if (state.removals < config_.threshold) ++state.removals;
+        if (config_.mode != Mode::Observe && config_.threshold != 0 &&
+            state.removals >= config_.threshold) {
+          activate(variable(decision.literal), state);
+          result.push_back(action(state));
+        }
+      }
+    }
+    level_ = level;
+    return result;
+  }
+
+  std::vector<Action> begin_solve() {
+    std::vector<Action> result;
+    if (config_.mode != Mode::Observe && config_.threshold == 0) {
+      for (auto& [var, state] : hints_) {
+        if (!state.active) activate(var, state);
+        result.push_back(action(state));
+      }
+    }
+    return result;
+  }
+
+  std::vector<Action> finish_solve() {
+    std::vector<Action> result;
+    for (const int var : active_) {
+      auto& state = hints_.at(var);
+      state.active = false;
+      result.push_back(Action{state.literal, false});
+      ++counts_.restores;
+    }
+    active_.clear();
+    for (auto& [var, state] : hints_) {
+      (void)var;
+      state.removals = 0;
+    }
+    assumptions_.clear();
+    connect();
+    return result;
+  }
+
+ private:
+  struct Hint {
+    int literal;
+    std::size_t removals, until, context;
+    bool active;
+  };
+  struct Decision {
+    int literal, hint;
+    std::size_t level, context;
+    bool overridden;
+  };
+  static int variable(int literal) { return literal < 0 ? -literal : literal; }
+  static std::size_t number(const char* name, std::size_t fallback) {
+    const char* text = std::getenv(name);
+    if (text == nullptr) return fallback;
+    const std::string_view input(text);
+    std::size_t value = 0;
+    const auto parsed = std::from_chars(input.data(), input.data() + input.size(), value);
+    if (input.empty() || parsed.ec != std::errc{} || parsed.ptr != input.data() + input.size() ||
+        value > 1000000000)
+      throw std::invalid_argument(name);
+    return value;
+  }
+  void activate(int var, Hint& state) {
+    state.active = true;
+    state.removals = 0;
+    state.until = clock_ + config_.window;
+    active_.insert(var);
+    ++counts_.activations;
+    trace("activate", var, state.literal);
+  }
+  Action action(const Hint& state) {
+    if (!state.active) return Action{state.literal, false};
+    if (config_.mode == Mode::Release) {
+      ++counts_.releases;
+      return Action{state.literal, true};
+    }
+    ++counts_.inversions;
+    return Action{-state.literal, false};
+  }
+  void trace(const char* event, int literal, int hint_literal) {
+    if (trace_count_++ >= config_.trace_limit) return;
+    std::fprintf(stderr,
+                 "PHASE_PROBE_EVENT {\"event\":\"%s\",\"literal\":%d,\"hint\":%d,"
+                 "\"level\":%zu,\"clock\":%zu}\n",
+                 event, literal, hint_literal, level_, clock_);
+  }
+  Config config_;
+  Counts counts_;
+  std::unordered_map<int, Hint> hints_;
+  std::unordered_set<int> active_, assumptions_;
+  std::vector<Decision> live_;
+  std::size_t level_ = 0, clock_ = 0, trace_count_ = 0;
+};
+
+}  // namespace primo::sat
diff --git a/src/smt/arithmetic_phase_simulation.hpp b/src/smt/arithmetic_phase_simulation.hpp
new file mode 100644
index 00000000..46ee984f
--- /dev/null
+++ b/src/smt/arithmetic_phase_simulation.hpp
@@ -0,0 +1,214 @@
+#pragma once
+
+#include <algorithm>
+#include <charconv>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <memory>
+#include <optional>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <unordered_map>
+#include <utility>
+
+#include "util/rational.hpp"
+
+namespace primo::smt {
+
+// Original isolated diagnostic: docs/leads/phase-region-simulation.md.
+// All results are preferences; neither interval counts nor history prove a lemma.
+class ArithmeticPhaseSimulation {
+ public:
+  enum class Mode : std::uint8_t { Observe, Random, Gated, Least, Most };
+  struct Config {
+    Mode mode = Mode::Observe;
+    std::uint32_t seed = 1;
+    unsigned denominator = 16;
+    std::size_t visits = 2;
+    std::size_t history_limit = 4096;
+    bool report = false;
+  };
+  struct Domain {
+    std::optional<util::Rational> lower;
+    std::optional<util::Rational> upper;
+    bool operator==(const Domain&) const = default;
+  };
+  struct Counts {
+    std::size_t refreshes = 0, entries = 0, finite_entries = 0, revisits = 0;
+    std::size_t candidates = 0, contexts = 0, assigned = 0, finite_splits = 0;
+    std::size_t narrow = 0, repeated = 0, flips = 0, evictions = 0;
+  };
+
+  explicit ArithmeticPhaseSimulation(Config config) : config_(config), random_(config.seed) {
+    if (config.denominator == 0 || config.visits == 0 || config.history_limit == 0)
+      throw std::invalid_argument("invalid arithmetic phase simulation limits");
+  }
+  ~ArithmeticPhaseSimulation() {
+    if (!config_.report) return;
+    std::fprintf(stderr,
+                 "ARITH_PHASE_SUMMARY {\"refreshes\":%zu,\"entries\":%zu,\"finite_entries\":%zu,"
+                 "\"revisits\":%zu,\"candidates\":%zu,\"contexts\":%zu,\"assigned\":%zu,"
+                 "\"finite_splits\":%zu,\"narrow\":%zu,\"repeated\":%zu,\"flips\":%zu,"
+                 "\"evictions\":%zu}\n",
+                 counts_.refreshes, counts_.entries, counts_.finite_entries, counts_.revisits,
+                 counts_.candidates, counts_.contexts, counts_.assigned, counts_.finite_splits,
+                 counts_.narrow, counts_.repeated, counts_.flips, counts_.evictions);
+  }
+  ArithmeticPhaseSimulation(const ArithmeticPhaseSimulation&) = delete;
+  ArithmeticPhaseSimulation& operator=(const ArithmeticPhaseSimulation&) = delete;
+
+  static std::unique_ptr<ArithmeticPhaseSimulation> environment() {
+    const char* text = std::getenv("PRIMO_REGION_PHASE");
+    if (text == nullptr) return nullptr;
+    Config config;
+    const std::string_view mode(text);
+    if (mode == "random")
+      config.mode = Mode::Random;
+    else if (mode == "gated")
+      config.mode = Mode::Gated;
+    else if (mode == "least")
+      config.mode = Mode::Least;
+    else if (mode == "most")
+      config.mode = Mode::Most;
+    else if (mode != "observe")
+      throw std::invalid_argument("invalid PRIMO_REGION_PHASE");
+    config.seed = number("PRIMO_REGION_SEED", 1);
+    config.denominator = number("PRIMO_REGION_RATE", 16);
+    config.report = true;
+    return std::make_unique<ArithmeticPhaseSimulation>(config);
+  }
+
+  void begin_refresh() { ++counts_.refreshes; }
+  const Counts& counts() const { return counts_; }
+  std::size_t history_size() const { return history_.size(); }
+
+  void domain(std::size_t variable, Domain value) {
+    auto& state = domains_[variable];
+    if (state.valid && state.value == value) return;
+    state.value = std::move(value);
+    state.valid = true;
+    ++state.generation;
+    ++counts_.entries;
+    if (!size(state.value).has_value()) return;
+    ++counts_.finite_entries;
+    const auto name = key(variable, state.value);
+    if (const auto found = history_.find(name); found != history_.end()) {
+      if (found->second < config_.visits) ++found->second;
+      ++counts_.revisits;
+      return;
+    }
+    if (history_.size() == config_.history_limit) {
+      history_.erase(history_order_.front());
+      history_order_.pop_front();
+      ++counts_.evictions;
+    }
+    history_.emplace(name, 1);
+    history_order_.push_back(name);
+  }
+
+  // true_upper/false_endpoint are CLOSED integer endpoints, computed with
+  // existing delta-aware rounding by the SMT integration, never guessed +/-1.
+  int choose(std::size_t atom, std::size_t variable, int true_literal, int beta_literal,
+             bool unassigned, bool integer, bool true_upper, const util::Rational& true_endpoint,
+             const util::Rational& false_endpoint) {
+    ++counts_.candidates;
+    if (!unassigned) {
+      ++counts_.assigned;
+      atoms_.erase(atom);
+      return beta_literal;
+    }
+    const auto& region = domains_.at(variable);
+    auto& state = atoms_[atom];
+    if (state.valid && state.generation == region.generation && state.beta == beta_literal)
+      return state.chosen;
+    ++counts_.contexts;
+    state = AtomState{region.generation, beta_literal, beta_literal, true};
+    const bool beta_true = beta_literal == true_literal;
+    bool narrow_split = false;
+    bool geometric_gate = false;
+    bool narrow_true = false;
+    if (integer) {
+      Domain yes = intersect(region.value, true_upper, true_endpoint);
+      Domain no = intersect(region.value, !true_upper, false_endpoint);
+      const auto yes_size = size(yes);
+      const auto no_size = size(no);
+      if (yes_size && no_size && *yes_size > util::Rational(0) && *no_size > util::Rational(0)) {
+        ++counts_.finite_splits;
+        narrow_true = *yes_size < *no_size;
+        const auto& small = narrow_true ? *yes_size : *no_size;
+        const auto& large = narrow_true ? *no_size : *yes_size;
+        if (small <= util::Rational(4) && large >= small * util::Rational(4)) {
+          narrow_split = true;
+          ++counts_.narrow;
+          const Domain& child = narrow_true ? yes : no;
+          const auto found = history_.find(key(variable, child));
+          geometric_gate = found != history_.end() && found->second >= config_.visits;
+          if (geometric_gate) ++counts_.repeated;
+        }
+      }
+    }
+    if (config_.mode == Mode::Random ||
+        (config_.mode == Mode::Gated && geometric_gate && beta_true == narrow_true)) {
+      if (std::uniform_int_distribution<unsigned>(0, config_.denominator - 1)(random_) == 0)
+        state.chosen = -beta_literal;
+    } else if (narrow_split && config_.mode == Mode::Least) {
+      state.chosen = narrow_true ? -true_literal : true_literal;
+    } else if (narrow_split && config_.mode == Mode::Most) {
+      state.chosen = narrow_true ? true_literal : -true_literal;
+    }
+    if (state.chosen != beta_literal) ++counts_.flips;
+    return state.chosen;
+  }
+
+ private:
+  struct DomainState {
+    Domain value;
+    std::size_t generation = 0;
+    bool valid = false;
+  };
+  struct AtomState {
+    std::size_t generation = 0;
+    int beta = 0;
+    int chosen = 0;
+    bool valid = false;
+  };
+  static unsigned number(const char* name, unsigned fallback) {
+    const char* value = std::getenv(name);
+    if (value == nullptr) return fallback;
+    const std::string_view text(value);
+    unsigned result = 0;
+    const auto parsed = std::from_chars(text.data(), text.data() + text.size(), result);
+    if (parsed.ec != std::errc{} || parsed.ptr != text.data() + text.size())
+      throw std::invalid_argument(std::string("invalid ") + name);
+    return result;
+  }
+  static std::optional<util::Rational> size(const Domain& domain) {
+    if (!domain.lower || !domain.upper) return std::nullopt;
+    return std::max(util::Rational(0), *domain.upper - *domain.lower + util::Rational(1));
+  }
+  static Domain intersect(Domain domain, bool upper, const util::Rational& endpoint) {
+    auto& bound = upper ? domain.upper : domain.lower;
+    if (!bound || (upper ? endpoint < *bound : endpoint > *bound)) bound = endpoint;
+    return domain;
+  }
+  static std::string key(std::size_t variable, const Domain& domain) {
+    return std::to_string(variable) + ":" + domain.lower->to_string() + ":" +
+           domain.upper->to_string();
+  }
+
+  Config config_;
+  std::mt19937 random_;
+  Counts counts_;
+  std::unordered_map<std::size_t, DomainState> domains_;
+  std::unordered_map<std::size_t, AtomState> atoms_;
+  std::unordered_map<std::string, std::size_t> history_;
+  std::deque<std::string> history_order_;
+};
+
+}  // namespace primo::smt
