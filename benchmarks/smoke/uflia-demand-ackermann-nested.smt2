(set-logic QF_UFLIA)
(set-info :status sat)
(declare-sort A 0)
(declare-const a A)
(declare-const b A)
(declare-const c A)
(declare-const z Int)
(declare-const q Bool)
(declare-fun f (A) A)
(declare-fun g (A) A)
(assert (<= 0 z))
(assert (= a c))
(assert (or (= b c) q))
(assert (not (= (f (g a)) (f (g b)))))
(check-sat)
