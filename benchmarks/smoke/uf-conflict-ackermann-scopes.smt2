(set-logic QF_UF)
(declare-sort A 0)
(declare-const a A)
(declare-const b A)
(declare-const q Bool)
(declare-fun f (A) A)
(push 1)
(assert (or (= a b) q))
(assert (not (= (f a) (f b))))
(check-sat)
(pop 1)
(assert (= a b))
(check-sat)
(push 1)
(assert (not (= (f a) (f b))))
(check-sat)
(pop 1)
(check-sat)
(exit)
