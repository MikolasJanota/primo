(set-logic QF_UF)
(set-info :status sat)
(declare-sort U 0)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-fun f (U) U)
(assert (distinct a b c))
(assert (or (= (f a) a) (= (f a) b) (= (f a) c)))
(assert (or (= (f b) a) (= (f b) b) (= (f b) c)))
(assert (or (= (f c) a) (= (f c) b) (= (f c) c)))
(assert (distinct (f a) (f b) (f c)))
(assert (not (= (f a) a)))
(assert (not (= (f b) b)))
(assert (not (= (f c) c)))
(check-sat)
