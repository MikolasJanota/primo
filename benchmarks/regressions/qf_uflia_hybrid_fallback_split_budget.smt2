(set-logic QF_UFLIA)
(set-info :status sat)
(declare-sort U 0)
(declare-fun f (Int) U)
(declare-const x Int)
(declare-const y Int)
(declare-const a Int)
(declare-const b Int)
(assert (>= (* 2 x) 1))
(assert (= (* 2 y) (+ a b)))
(assert (distinct (f a) (f b)))
(assert (>= a 0))
(assert (<= a 2))
(assert (>= b 0))
(assert (<= b 2))
(check-sat)
