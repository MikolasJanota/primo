(set-option :produce-models true)
(set-logic QF_UFLIA)
(set-info :status unsat)
(declare-const x Int)
(declare-const y Int)
(declare-const d Int)
(declare-fun p (Int) Bool)
(assert (<= 0 d))
(assert (<= d 0))
(assert (<= (+ y d) x))
(assert (<= x (+ y d)))
(assert (p x))
(assert (not (p y)))
(check-sat)
