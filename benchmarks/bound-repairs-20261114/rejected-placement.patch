+void placement_after_constant_simplification() {
+  primo::smt::CheckSatOptions options;
+  options.preprocess_bound_tightening = true;
+  options.check_model = true;
+  options.monotone_elimination = false;
+  options.preprocessing_mode = primo::smt::PreprocessingMode::Basic;
+  const std::string input =
+      "(set-logic QF_LIA)(declare-const x Int)(declare-const y Int)"
+      "(declare-const z Int)(assert (= x 0))(assert (= y 20))"
+      "(assert (< z (- (+ x y) 1)))(check-sat)";
+  const auto simplified = primo::smt::check_sat_smtlib(input, options);
+  assert(simplified.result == primo::smt::CheckSatResult::Sat);
+  assert(simplified.statistics.get(":preprocessing.bounds.emitted") == 0);
+  assert(simplified.statistics.get(":preprocessing.bounds.redundant-endpoints") > 0);
+  // With ordinary preprocessing disabled, the explicit bound pass still runs.
+  options.preprocessing_mode = primo::smt::PreprocessingMode::Off;
+  const auto isolated = primo::smt::check_sat_smtlib(input, options);
+  assert(isolated.result == primo::smt::CheckSatResult::Sat);
+  assert(isolated.statistics.get(":preprocessing.bounds.work") > 0);
+}
+
