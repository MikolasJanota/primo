+// Diagnostic-only snapshot patch: observe root fmt1 bounds without modifying them.
+void trace_fmt1_bound(
+    const PreparedLraTheory& prepared, const PreparedLraTheory::PreparedAtom& atom,
+    const theory::arithmetic::LraTableau& tableau, bool value, int literal,
+    const std::optional<theory::arithmetic::LraTableau::BoundInfo>& before_upper,
+    const std::optional<theory::arithmetic::LraTableau::BoundInfo>& before_lower) {
+  if (atom.relation == theory::arithmetic::LraRelation::Eq) return;
+  bool target = false;
+  for (const auto& [term, variable] : prepared.var_ids_) {
+    if (variable != atom.bound_var) continue;
+    const auto& node = prepared.terms_.get(term);
+    if (node.kind == core::TermKind::Constant &&
+        prepared.terms_.symbols().get_symbol(node.symbol).name == "fmt1")
+      target = true;
+  }
+  if (!target) return;
+  const auto assertion = bound_assertion(atom.relation, atom.rhs, atom.asserts_lower_when_true,
+                                         value, atom.integer_rounding);
+  const auto before = assertion.is_upper ? before_upper : before_lower;
+  const auto after = assertion.is_upper ? tableau.upper_bound(atom.bound_var)
+                                        : tableau.lower_bound(atom.bound_var);
+  std::cerr << "TRACE_FMT1 lit=" << literal << " variable=" << atom.bound_var
+            << " relation=" << (atom.relation == theory::arithmetic::LraRelation::Lt ? "lt" : "le")
+            << " rhs=" << atom.rhs.to_string() << " truth=" << value
+            << " upper=" << assertion.is_upper
+            << " asserted=" << assertion.value.rational.to_string()
+            << " delta=" << assertion.value.infinitesimal.to_string()
+            << " before=" << (before ? before->value.rational.to_string() : "infinite")
+            << " after=" << (after ? after->value.rational.to_string() : "infinite") << '\n';
+}
